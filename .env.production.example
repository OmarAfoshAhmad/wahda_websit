# Production environment (used by docker-compose.prod.yml)
DATABASE_URL=postgresql://wahda_user:CHANGE_ME@db:5432/wahda
JWT_SECRET=CHANGE_ME_WITH_AT_LEAST_64_RANDOM_CHARACTERS
BACKUP_ENCRYPTION_KEY=CHANGE_ME_WITH_A_DIFFERENT_RANDOM_KEY
BENEFICIARY_TOKEN_SECRET=CHANGE_ME_WITH_A_DIFFERENT_RANDOM_KEY
# Must be different from JWT_SECRET
BENEFICIARY_JWT_SECRET=CHANGE_ME_WITH_A_DIFFERENT_RANDOM_KEY
INITIAL_BALANCE=1000
PORT=3000
APP_HOST_PORT=3000
NODE_ENV=production

# Main administrator facility ID, populated after the first deployment
WAAD_FACILITY_ID=CHANGE_ME

# Redis
REDIS_PASSWORD=CHANGE_ME_WITH_A_RANDOM_PASSWORD

# Optional bootstrap administrator, used only when no active administrator exists
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=CHANGE_ME_WITH_A_RANDOM_PASSWORD
DEFAULT_ADMIN_NAME=System Administrator

# Optional default password for imported or reset facility users
DEFAULT_FACILITY_PASSWORD=CHANGE_ME_WITH_A_RANDOM_PASSWORD
